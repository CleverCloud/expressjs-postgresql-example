extends layout

block content
  nav.navbar.navbar-dark.bg-primary.mb-4
    .container
      a.navbar-brand(href="#") #{title}

  .container
    .row.justify-content-center
      .col-md-6
        form.input-group.mb-3(id="createForm" method="post" action="/values")
          input.form-control(type="text" name="value" id="value" placeholder="Enter a value" maxlength=32)
          button.btn.btn-success(type="submit") Submit

        ul.list-group(id="list")
          li.list-group-item.active Values
          each val, id in values
            li.list-group-item.d-flex.justify-content-between.align-items-center(id=id)
              span= val
              button.btn.btn-danger.btn-sm(data-id=id, onclick="deleteItem(this)") Delete

    .modal.fade(id="errorModal" tabindex="-1" aria-hidden="true")
      .modal-dialog
        .modal-content
          .modal-header
            h5.modal-title Error
            button.close(type="button" data-bs-dismiss="modal" aria-label="Close")
          .modal-body(id="errorField")
          .modal-footer
            button.btn.btn-danger.btn-sm(type="button" data-bs-dismiss="modal") Close
